# Server-only. Set on the Vercel PREVIEW environment first. Never commit real values.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Defaults to src/config.mjs contact.email. Change this if the business inbox changes.
CONTACT_TO_EMAIL=contact@avarapath.com
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Comma-separated exact origins. VERCEL_URL preview origin is included automatically.
CONTACT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
